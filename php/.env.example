# Happy Server PHP - Environment Configuration
# Copy this file to .env and configure for your environment

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.happyserver.com

# Server
HTTP_PORT=3000
WEBSOCKET_PORT=8080
SERVER_HOST=0.0.0.0

# Database
DB_CONNECTION=sqlite
DB_DATABASE=storage/database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=happy
# DB_PASSWORD=secret
# DB_DATABASE=happy_server

# Security (REQUIRED - CHANGE THESE!)
MASTER_SECRET=change-this-to-a-random-32-byte-secret
JWT_SECRET=change-this-to-a-random-jwt-secret
ADMIN_PASSWORD=change-this-admin-password

# Logging
LOG_LEVEL=info
LOG_CHANNEL=file
LOG_FILE_PATTERN=storage/logs/{date}.log
LOG_MAX_FILES=30
LOG_REQUESTS=true
LOG_QUERIES=false

# Cache
CACHE_DRIVER=file
CACHE_TTL=3600
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DATABASE=0

# Session
SESSION_TIMEOUT=3600
SESSION_AUTO_CLEANUP=true

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Push Notifications
FCM_SERVER_KEY=

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=storage/files
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,txt,md

# AWS S3 (if using s3 storage driver)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_WHITELIST=127.0.0.1

# Monitoring
METRICS_ENABLED=true
METRICS_PATH=/metrics
ADMIN_DASHBOARD_ENABLED=true
ADMIN_DASHBOARD_PATH=/admin
TRACK_PERFORMANCE=true

# WebSocket
WEBSOCKET_ENABLED=true
WEBSOCKET_HEARTBEAT=30
WEBSOCKET_MAX_CONNECTIONS=10

# Compatibility
NODE_COMPATIBLE=true
STRICT_VALIDATION=true
USE_CAMEL_CASE=true
